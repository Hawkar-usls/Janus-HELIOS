{
  "schema": "janus.helios.public-config.v1",
  "branding": {
    "product_name": "JANUS HELIOS",
    "station_name": "HELIOS STATION",
    "tagline": "ONE CORE. ANY DESTINATION.",
    "default_route": "market",
    "default_game_mode": "helios"
  },
  "resource_policy": {
    "compute_off_by_default": true,
    "cpu_default_percent": 15,
    "cpu_max_percent": 30,
    "gpu_default": false,
    "immediate_revoke": true
  },
  "game_modes": [
    {"key": "helios", "label": "HELIOS", "enabled": true, "role": "UNIVERSAL_CORE_PROFILE", "supports_demo_spin_energy": false},
    {"key": "divine", "label": "DIVINE", "enabled": true, "role": "RADIANT_FIVE_LINE_PROFILE", "supports_demo_spin_energy": false},
    {"key": "gridjack", "label": "GRIDJACK", "enabled": true, "role": "TREASURY_NINE_LINE_PROFILE", "supports_demo_spin_energy": true},
    {"key": "custom", "label": "CUSTOM", "enabled": true, "role": "BUYER_CONFIGURABLE_PROFILE", "supports_demo_spin_energy": false}
  ],
  "demo_spin_energy": {
    "enabled": true,
    "seconds_per_spin": 30,
    "max_bank": 3,
    "eligible_game_modes": ["gridjack"],
    "eligible_routes": ["market", "science", "jackpot", "datacenter", "operator", "custom"],
    "reward_ledger": "DEMO_ENERGY_REWARD_ONLY",
    "real_money_value": false,
    "automatic_wager_conversion": false,
    "auto_play_from_bank": false,
    "note": "Public demo only. In GRIDJACK, any configured active compute route may accumulate non-cash demo spins. Production compute value must not automatically become wagers, free spins, gambling balance or better gambling terms."
  },
  "demo_cascades": {
    "enabled": true,
    "eligible_game_modes": ["helios", "divine", "gridjack", "custom"],
    "multiplier_ladder": [1, 4, 16, 64],
    "max_cascades": 8,
    "collapse_ms": 260,
    "refill_ms": 340,
    "affects_compute": false,
    "compute_effect": "NONE",
    "note": "A paid line removes its winning symbols, surviving symbols fall, new symbols enter from above, and the grid is evaluated again. Successful consecutive cascades climb x1 → x4 → x16 → x64. The cascade engine never reads compute route, compute units, provider receipt or player compute contribution when generating outcomes."
  },
  "demo_solar_corona": {
    "enabled": true,
    "eligible_game_modes": ["helios"],
    "trigger_symbol": "☀",
    "trigger_count": 3,
    "multipliers": [2, 3, 4, 5, 8, 10, 16, 25],
    "reward_ledger": "SOLAR_BONUS_BANK",
    "real_money_value": false,
    "affects_compute": false,
    "affects_rng": false,
    "affects_route": false,
    "note": "Natural HELIOS identity event. Three or more sun symbols on a settled non-bonus HELIOS grid ignite the Solar Corona wheel. This event remains separate from the purchased Solar Free Spins session and never changes compute routing."
  },
  "demo_bonus_buy": {
    "enabled": true,
    "eligible_game_modes": ["helios"],
    "feature": "SOLAR_CORONA_FREE_SPINS",
    "cost_multiplier_of_demo_bet": 50,
    "purchase_currency": "DEMO_PRESENTATION_UNITS",
    "free_spins_count": 10,
    "retrigger_symbol": "☀",
    "retrigger_count": 3,
    "retrigger_spins": 2,
    "max_total_spins": 16,
    "inter_spin_delay_ms": 650,
    "bonus_session_ledger": "DEMO_SOLAR_FREE_SPINS",
    "winnings_settle_to_demo_balance": true,
    "reward_ledger": "SOLAR_BONUS_BANK",
    "real_money_value": false,
    "production_enabled": false,
    "affects_compute": false,
    "affects_compute_route": false,
    "note": "Public capability demo only. Buying Corona starts 10 automatic free spins using the same independent game RNG and cascade system. Three or more suns during the bonus retrigger +2 spins up to 16 total. Some sessions may pay little and others may become large through normal cascades; there is no compute-dependent outcome shaping. Production real-money feature buy remains disabled pending separate jurisdiction, platform, responsible-gaming and game-math review."
  },
  "demo_lucky_contribution": {
    "enabled": true,
    "demo_probability_per_receipt": 0.005,
    "showcase_manual_trigger": true,
    "eligible_route_classes": ["MARKETPLACE", "TREASURY", "SCIENCE", "PUBLIC_GOOD", "DATACENTER", "OPERATOR", "CUSTOM"],
    "demo_reward_units": 1,
    "reward_ledger": "LUCKY_CONTRIBUTION_LEDGER",
    "notification_surface": "HELIOS_PROFILE",
    "real_money_value": false,
    "wagering_value": false,
    "production_requires_authoritative_receipt": true,
    "production_browser_self_verification": false,
    "production_selection_model": "AUTHORITATIVE_SIGNIFICANCE_RULE_NOT_BROWSER_PROBABILITY",
    "route_labels": {
      "MARKETPLACE": "LUCKY HASH",
      "TREASURY": "LUCKY HASH",
      "SCIENCE": "IMPACT HIT",
      "PUBLIC_GOOD": "IMPACT HIT",
      "DATACENTER": "GOLDEN TASK",
      "OPERATOR": "GOLDEN TASK",
      "CUSTOM": "GOLDEN TASK"
