    "event_inputs": ["GAME_MODE", "SPIN_START", "PAID_CASCADE", "SPIN_COMPLETE", "SOLAR_CORONA", "SPIN_ENERGY_EARNED", "LUCKY_CONTRIBUTION", "BONUS_BUY", "BONUS_SESSION_START", "BONUS_SPIN", "BONUS_SESSION_COMPLETE", "ROUTE_CHANGE", "COMPUTE_STATE"],
    "event_tempo_behavior": {
