{
  "schema": "janus.helios.route_aura.v1",
  "module": "helios-route-aura.js",
  "version": "1.2.0",
  "classification": "PRESENTATION_ONLY_LOCAL_REEL_ROUTE_AURA",
  "purpose": "Render a local multispectral glow around the reel field from the Reel Forge palette, with intensity derived from explicit CPU/GPU user resource caps and deterministic sparks only at the configured maximum policy while compute is active.",
  "inputs": ["ACTIVE_ROUTE", "GAME_MODE_PRESENTATION_STATE", "REEL_FORGE_PALETTE", "MUSIC_SESSION_SEED", "CPU_GPU_USER_RESOURCE_POLICY", "COMPUTE_ACTIVE_FOR_INTENSITY_ONLY"],
  "palette_source": "REEL_FORGE_PRIMARY_SECONDARY_TERTIARY",
  "intensity_source": "CPU_GPU_USER_RESOURCE_POLICY",
  "max_policy_sparks": {
    "enabled": true,
    "requires_compute_active": true,
    "requires_both_cpu_and_gpu_at_configured_max": true,
    "deterministic_session_seeded": true
  },
  "locality": "REELS_AND_LOCAL_GAME_PANEL_PERIMETER_ONLY",
  "fullscreen_overlay": false,
  "reads_game_math": false,
  "reads_spin": false,
  "reads_win": false,
  "reads_bet": false,
  "reads_balance": false,
  "authority": {
    "rng_effect": "NONE",
    "rtp_effect": "NONE",
    "payout_effect": "NONE",
    "compute_routing_effect": "NONE"
  }
}
