{
  "schema": "janus.helios.route_aura.v1",
  "module": "helios-route-aura.js",
  "version": "1.1.0",
  "classification": "PRESENTATION_ONLY_LOCAL_REEL_ROUTE_AURA",
  "purpose": "Render a local multispectral glow around the reel field from the generated Reel Forge palette, preserving the active mode, route and session-seed colour combination instead of imposing an independent aura palette.",
  "inputs": ["ACTIVE_ROUTE", "GAME_MODE_PRESENTATION_STATE", "REEL_FORGE_PRIMARY_SECONDARY_TERTIARY_PALETTE", "MUSIC_SESSION_SEED", "COMPUTE_ACTIVE_FOR_INTENSITY_ONLY"],
  "palette_source": "REEL_FORGE",
  "multispectral": true,
  "locality": "REELS_ONLY",
  "fullscreen_overlay": false,
  "reads_game_math": false,
  "reads_spin": false,
  "reads_win": false,
  "reads_bet": false,
  "reads_balance": false,
  "authority": {
    "rng_effect": "NONE",
    "rtp_effect": "NONE",
    "payout_effect": "NONE",
    "compute_routing_effect": "NONE"
  }
}