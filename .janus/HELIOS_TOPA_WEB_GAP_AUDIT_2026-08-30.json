  "findings": [
    {"id":"WEB-H01","priority":"P0_FIXED","finding":"LATEST_RECEIPT_WAS_MACHINE_FIRST_DEBUG_UI","status":"IMPLEMENTED_HELIOS_RECEIPT_VIEWER_V1","implementation":"Human summary first; canonical JSON preserved one disclosure level deeper with COPY JSON."},
    {"id":"WEB-H02","priority":"P1_FIXED_DEMO","finding":"PUBLIC_COCKPIT_DOES_NOT_SHOW_PROVIDER_OR_AGENT_TRUST_STATE","status":"IMPLEMENTED_DEMO_TRUST_STRIP","implementation":"Buyer cockpit exposes AGENT / PROVIDER / VERIFIER / PROOF state without inventing production reliability or availability."},
    {"id":"WEB-H03","priority":"P1_FIXED_DEMO","finding":"RESOURCE_POLICY_IS_CAP_BASED_BUT_NOT_DEVICE_COMFORT_AWARE","status":"IMPLEMENTED_BUYER_GOVERNOR_POLICY_PREVIEW","implementation":"Buyer Lab exposes idle-only, AC-only, GPU-while-idle, pause-on-interaction, thermal, watt, concurrency and quiet-hours policy. Static page does not claim enforcement; Desktop Agent/Fabric remains authoritative."},
    {"id":"WEB-H04","priority":"P1_FIXED_DEMO","finding":"ROUTE_SELECTION_LACKS_HARDWARE_FIT_AND_CURRENT_AVAILABILITY_CONTEXT","status":"IMPLEMENTED_CAPABILITY_HINTS_NO_FAKE_AVAILABILITY","implementation":"Route cards expose coarse CPU/GPU/HYBRID or manifest preference and workload-fit hints. Real availability remains a buyer/provider hook."},
    {"id":"WEB-H05","priority":"P1_FIXED_DEMO","finding":"PUBLIC_RECEIPT_HAS_PROOF_KIND_BUT_NO_FIRST_CLASS_VERIFICATION_CHAIN","status":"IMPLEMENTED_DEMO_VERIFICATION_CHAIN_AND_RECEIPT_PROOF_LABELS","implementation":"DEMO / UNVERIFIED / VERIFIED semantics are explicit; Buyer Lab shows manifest, artifact digest, agent, verifier and optional sign/attest hook positions."},
    {"id":"WEB-H06","priority":"P1_FIXED_DEMO","finding":"COMPUTE_LIFECYCLE_IS_TOO_BINARY","status":"IMPLEMENTED_SIMULATED_LIFECYCLE_PREVIEW","implementation":"Compact ARMED -> ADMITTING -> SCHEDULING -> RUNNING -> VERIFYING -> RECEIPT strip demonstrates buyer-facing lifecycle without claiming authoritative provider runtime."},
    {"id":"WEB-H07","priority":"P1_FIXED_DEMO","finding":"NO_USER_VISIBLE_INTERRUPTIBILITY_OR_FAILURE_SEMANTICS","status":"IMPLEMENTED_RESILIENCE_HOOK_VIEW","implementation":"Buyer Lab exposes lease-fencing/stale-result core primitive and retry/reassignment integration hook without fabricating failure telemetry."},
    {"id":"WEB-H08","priority":"P1_FIXED","finding":"RULES_AND_COMPUTE_EXPLANATIONS_ARE_PRESENT_BUT_FRAGMENTED","status":"IMPLEMENTED_ONE_EXPLAIN_PANEL","implementation":"Buyer Lab consolidates RNG-compute separation, consent/revoke, demo proof semantics, replaceable backend and buyer handoff boundaries."},
    {"id":"WEB-H09","priority":"P2_FIXED_DEMO","finding":"NO_PORTABLE_USER_FACING_COMPUTE_PROVENANCE_HISTORY","status":"IMPLEMENTED_DEMO_COMPUTE_PASSPORT","implementation":"Session-only passport collects up to 24 demo compute receipts and exports non-authoritative JSON with no wagering value."},
    {"id":"WEB-H10","priority":"P2_FIXED_DEMO","finding":"NO_COARSE_CAPABILITY_SELF_TEST_BEFORE_ROUTING","status":"IMPLEMENTED_OPT_IN_COARSE_LOCAL_SELF_TEST","implementation":"User-triggered local-only CPU thread-class bucket and WebGPU API visibility check; no GPU vendor/model/exact adapter limits and no network transmission."}
