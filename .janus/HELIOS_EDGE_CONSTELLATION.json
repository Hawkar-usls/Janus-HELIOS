    "janus_i0_background_ip_status": "SEPARATELY_SCOPED",
    "nerdminer_v2_status": "EXTERNAL_MIT_COMPATIBILITY_TARGET",
    "asic_or_pool_partnership_implied": false,
    "future_hardware_adapter_assignment_implied": false
  },
  "authority": {
