{
  "schema": "janus.helios.edge-constellation.contract.v1",
  "version": "1.1.0",
  "classification": "HETEROGENEOUS_EDGE_REPLICATION_AND_EVIDENCE_PLANE",
  "purpose": "Extend HELIOS Edge Hash Lab from one compatible edge node into a heterogeneous replication plane where every device first runs its own balanced JANUS I0 versus randomized-mirror comparison and cross-node evidence passes an explicit Evidence Independence Engine before synthesis.",
  "core_laws": [
    "NODE_POWER_NOT_EQUAL_EVIDENCE_WEIGHT",
    "REPLICATION_COUNT_NOT_EQUAL_INDEPENDENT_ROOT_COUNT"
  ],
  "node_classes": {
    "NERDMINER_ESP32": {"compute_family":"MICROCONTROLLER","execution_plane":"EXTERNAL_EDGE_BRIDGE","default_transport":"STRATUM_V1","reference_target":"BitMaker-hub/NerdMiner_v2"},
    "DESKTOP_CPU": {"compute_family":"DESKTOP_CPU","execution_plane":"HELIOS_DESKTOP_FABRIC","default_transport":"HELIOS_DESKTOP_FABRIC"},
    "DESKTOP_GPU": {"compute_family":"DESKTOP_GPU","execution_plane":"HELIOS_DESKTOP_FABRIC","default_transport":"HELIOS_DESKTOP_FABRIC"},
    "ASIC_GATEWAY": {"compute_family":"ASIC","execution_plane":"APPROVED_EXTERNAL_GATEWAY","default_transport":"STRATUM_V1_GATEWAY"}
  },
  "local_experiment_law": {
    "pairing": "WITHIN_NODE_STRICT_50_50",
    "arms": ["JANUS_I0", "RANDOMIZED_MIRROR"],
    "equal_checked_work_required": true,
    "same_device_required": true,
    "same_pool_required": true,
    "same_job_stream_required": true,
    "same_wire_required": true,
    "same_guardian_policy_required": true,
    "raw_counts_alone_are_sufficient": false
  },
  "evidence_independence_gate": {
    "required": true,
    "engine": "HELIOS_EVIDENCE_INDEPENDENCE_ENGINE",
    "required_roots": [
      "physical_device_root",
      "execution_lineage_root",
      "authority_root",
      "site_network_root",
      "observation_epoch_root",
      "job_stream_root"
    ],
    "unknown_counts_as_independent": false,
    "hardware_class_is_independence_root": false,
    "selection": "MAXIMUM_PAIRWISE_STRONGLY_INDEPENDENT_SET",
    "minimum_strongly_independent_complete_nodes": 2
  },
  "cross_node_replication_law": {
    "pre_independence_unit": "NODE_LOCAL_EFFECT_VECTOR",
    "post_independence_unit": "STRONGLY_INDEPENDENT_NODE_LOCAL_EFFECT_VECTOR",
    "node_power_not_evidence_weight": true,
    "raw_hashrate_cross_node_weighting": false,
    "raw_checked_work_cross_node_weighting": false,
    "aggregation": "MEDIAN_INDEPENDENT_NODE_LOCAL_DELTA_PLUS_DIRECTIONAL_CONSISTENCY",
    "high_throughput_hardware_gets_more_votes": false,
    "correlated_reports_are_deleted": false,
    "correlated_reports_get_independent_votes": false,
    "directional_consistency_is_causal_proof": false,
    "isolated_rare_tail_is_proof": false,
    "profit_inference_allowed": false
  },
  "reasoning": {
    "problem": "A fleet can create misleading replication evidence if throughput or shared device/firmware/provider/network/time/job lineage is mistaken for independent confirmation.",
    "solution": "Normalize I0 versus randomized control inside each node, preserve every complete report, construct a strong-independence graph from attested roots, then synthesize only the maximum pairwise-independent set.",
    "consequence": "Hardware speed changes time-to-exposure; duplicated infrastructure can add reports but cannot automatically add independent replication weight."
  },
  "admission": {
    "node_identity_required": true,
    "bridge_or_executor_identity_required": true,
    "conformance_gate_required": true,
    "provider_or_pool_authority_required_for_real_execution": true,
    "guardian_policy_required": true,
    "firmware_or_executor_digest_required_for_authoritative_evidence": true,
    "evidence_lineage_required_for_independent_claim": true,
    "production_gate_default": "DENY"
  },
  "public_demo": {
    "connected_devices": 0,
    "connects_to_nodes": false,
    "connects_to_pool": false,
    "requests_serial_device": false,
    "collects_wallet_address": false,
    "collects_wifi_credentials": false,
    "fake_hashrate": false,
    "fake_temperature": false,
    "fake_watts": false,
    "fake_independence_score": false,
    "campaign_builder": "PRESENTATION_ONLY"
  },
  "commercial_boundary": {
    "janus_i0_full_scheduler_embedded": false,
    "janus_i0_background_ip_status": "SEPARATELY_SCOPED",
    "nerdminer_v2_status": "EXTERNAL_MIT_COMPATIBILITY_TARGET",
    "asic_or_pool_partnership_implied": false,
    "future_hardware_adapter_assignment_implied": false
  },
  "authority": {
    "game_effect": "NONE",
    "rng_effect": "NONE",
    "rtp_effect": "NONE",
    "payout_effect": "NONE",
    "game_math_authority": "NONE",
    "public_compute_execution_authority": "NONE",
    "settlement_authority": "NONE"
  }
}